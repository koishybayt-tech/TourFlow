# Секрет приложения (подпись сессий). Сгенерировать: openssl rand -base64 32
NUXT_APP_SECRET=
# Ключ шифрования ИИН и паспортов: 32 байта base64. Сгенерировать: openssl rand -base64 32
PII_ENCRYPTION_KEY=
DATABASE_URL=postgresql://tourflow:tourflow@localhost:5432/tourflow
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=tourflow
S3_ACCESS_KEY=tourflow
S3_SECRET_KEY=tourflow-s3-secret
GOTENBERG_URL=http://localhost:3001
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Tourflow <no-reply@tourflow.local>
PUBLIC_BASE_URL=http://localhost:3000

# Провайдеры: mock | real
MESSAGING_PROVIDER=mock
SIGNING_PROVIDER=mock
TOUR_SEARCH_PROVIDER=mock
TOURVISOR_TOKEN=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=
TELEGRAM_BOT_TOKEN=

# Только для docker-compose.prod.yml
DOMAIN=crm.example.kz
POSTGRES_PASSWORD=
IMAGE=ghcr.io/koishybayt-tech/tourflow:latest
