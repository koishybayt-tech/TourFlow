// Tourflow data model. See docs/03_DATA_MODEL.md.
// Money: Int tenge. Foreign currency: Decimal(12,2) + Currency. Times in UTC, shown in Asia/Almaty.
// Every tenant table carries organizationId; server/utils/db.ts scopes queries by it.

generator client {
  provider     = "prisma-client"
  output       = "../server/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  CALLCENTER
  GUIDE
}

enum Pipeline {
  GROUP
  PACKAGE
  BASE
}

enum Channel {
  WHATSAPP
  INSTAGRAM
  SITE
  MANUAL
  CALL
  OFFICE
  REFERRAL
}

enum Currency {
  KZT
  EUR
  USD
  CHF
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum TourStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVE
}

enum OfferStatus {
  DRAFT
  SENT
  CHOSEN
  REJECTED
}

enum BookingStatus {
  REQUEST
  CONFIRMED
  PAID
  CANCELLED
}

enum SignStatus {
  NONE
  SENT
  SIGNED
  PAPER
}

enum RequirementType {
  FIELD
  DOC
  SIGN
  PAY
  COMMENT
  CHECK
  DEPARTURE
  TRAVELERS
  EVENT
  CLIENT
}

// ───────────────────────── Organization & people ─────────────────────────

model Organization {
  id           String   @id @default(cuid())
  name         String
  bin          String
  city         String   @default("Алматы")
  director     String
  legalAddress String
  bank         String
  iik          String
  bik          String
  license      String?
  phone        String
  email        String
  instagram    String?
  refundRule   String
  refundHoldPct Int     @default(10)
  /// { group, package, tickets, team, migration }
  modules      Json
  /// { channels: {WHATSAPP:'auto'|'GROUP'|...}, fallback: 'queue'|'BASE', keywords: {GROUP:[...],...}, links: [{tag,label,pipeline,departureId}] }
  routing      Json
  defaultManagerId String?
  dealCounter  Int      @default(0)
  contractCounter Int   @default(0)
  createdAt    DateTime @default(now())

  members       Member[]
  clients       Client[]
  deals         Deal[]
  stages        Stage[]
  directions    Direction[]
  conversations Conversation[]
  tasks         Task[]
  events        Event[]
  departures    Departure[]
  guides        Guide[]
  tours         Tour[]
  operators     Operator[]
  templates     DocumentTemplate[]
  notifications Notification[]
  auditLogs     AuditLog[]
  invites       Invite[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  phone          String?  @unique
  passwordHash   String
  name           String
  position       String?
  telegramChatId String?
  telegramCode   String?  @unique
  createdAt      DateTime @default(now())

  members       Member[]
  resetTokens   PasswordReset[]
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           Role
  onVacation     Boolean      @default(false)
  signRight      Boolean      @default(false)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  managedDeals   Deal[]       @relation("DealManager")
  tasksAssigned  Task[]       @relation("TaskAssignee")
  tasksAuthored  Task[]       @relation("TaskAuthor")
  events         Event[]
  notifications  Notification[]

  @@unique([organizationId, userId])
  @@index([userId])
}

model Invite {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           Role
  token          String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Clients ─────────────────────────

model Client {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  phone          String
  extraPhones    String[]
  email          String?
  fullName       String?
  iinEnc         String?
  birthDate      DateTime? @db.Date
  address        String?
  source         Channel
  tags           String[]
  note           String?
  managerId      String?
  pdConsentAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  mergedIntoId   String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals        Deal[]
  travelers    Traveler[]

  @@unique([organizationId, phone])
  @@index([organizationId, name])
}

model Traveler {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String?
  dealId         String
  fullNameLatin  String
  passportNoEnc  String?
  passportExpiry DateTime? @db.Date
  birthDate      DateTime? @db.Date
  iinEnc         String?
  isChild        Boolean   @default(false)
  childAge       Int?
  visaStatus     String?
  order          Int       @default(0)
  createdAt      DateTime  @default(now())

  client       Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  deal         Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  participants Participant[]

  @@index([organizationId, dealId])
}

// ───────────────────────── Pipelines ─────────────────────────

model Direction {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  keywords       String[]
  managerIds     String[]
  mode           String       @default("single") // single | round
  backupId       String?
  rrIndex        Int          @default(0)
  order          Int          @default(0)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals          Deal[]
}

model Stage {
  id             String             @id @default(cuid())
  organizationId String
  pipeline       Pipeline
  order          Int
  name           String
  description    String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requirements   StageRequirement[]
  deals          Deal[]
  tasks          Task[]

  @@unique([organizationId, pipeline, order])
}

model StageRequirement {
  id       String          @id @default(cuid())
  stageId  String
  /// Stable key from the default regulation (e.g. g4a); used by seeds and tests.
  key      String?
  type     RequirementType
  label    String
  required Boolean         @default(true)
  /// {field:'budget'} | {docType:'Виза'} | {mode:'prepay', perPerson:100000} | {mode:'full'}
  config   Json            @default("{}")
  order    Int
  stage    Stage           @relation(fields: [stageId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Deals ─────────────────────────

model Deal {
  id             String    @id @default(cuid())
  organizationId String
  number         Int
  clientId       String
  pipeline       Pipeline
  stageId        String
  directionId    String?
  managerId      String?
  source         Channel
  title          String
  dates          String?
  people         Int       @default(1)
  budget         String?
  visaHistory    String?
  price          Int       @default(0)
  fullPayDeadline DateTime? @db.Date
  departureId    String?
  wonAt          DateTime?
  lostReason     String?
  lostComment    String?
  lostAt         DateTime?
  /// { [requirementId]: true }
  reqChecks      Json      @default("{}")
  /// { [requirementId]: 'text' }
  reqComments    Json      @default("{}")
  /// { [requirementId]: 'value' } for FIELD requirements without a deal column (e.g. booking number)
  reqValues      Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client        @relation(fields: [clientId], references: [id])
  stage        Stage         @relation(fields: [stageId], references: [id])
  direction    Direction?    @relation(fields: [directionId], references: [id], onDelete: SetNull)
  manager      Member?       @relation("DealManager", fields: [managerId], references: [id], onDelete: SetNull)
  departure    Departure?    @relation(fields: [departureId], references: [id], onDelete: SetNull)
  travelers    Traveler[]
  payments     Payment[]
  events       DealEvent[]
  notes        Note[]
  tasks        Task[]
  calendar     Event[]
  documents    Document[]
  contracts    Contract[]
  offers       Offer[]
  bookings     OperatorBooking[]
  conversations Conversation[]
  participants Participant[]

  @@unique([organizationId, number])
  @@index([organizationId, pipeline, stageId])
  @@index([organizationId, clientId])
  @@index([organizationId, managerId])
}

model Payment {
  id             String   @id @default(cuid())
  organizationId String
  dealId         String
  amount         Int
  type           String
  method         String
  comment        String?
  paidAt         DateTime
  createdById    String?
  createdAt      DateTime @default(now())
  deal           Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId, paidAt])
  @@index([dealId])
}

/// Immutable deal history. Never update or delete rows.
model DealEvent {
  id             String   @id @default(cuid())
  organizationId String
  dealId         String
  at             DateTime @default(now())
  actorId        String?
  actorLabel     String
  kind           String
  text           String
  data           Json?
  deal           Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, at])
}

model Note {
  id                 String   @id @default(cuid())
  organizationId     String
  dealId             String
  authorId           String?
  authorLabel        String
  text               String
  stageRequirementId String?
  createdAt          DateTime @default(now())
  deal               Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

// ───────────────────────── Messaging ─────────────────────────

model Conversation {
  id             String       @id @default(cuid())
  organizationId String
  channel        Channel
  externalId     String
  clientPhone    String
  clientName     String
  dealId         String?
  unread         Boolean      @default(true)
  /// { direction, dates, people, visa }
  lead           Json         @default("{}")
  pipelineOverride Pipeline?
  lastMessageAt  DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  messages       Message[]

  @@unique([organizationId, channel, externalId])
  @@index([organizationId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  direction      String // in | out
  text           String
  sentAt         DateTime
  auto           Boolean      @default(false)
  authorId       String?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
}

// ───────────────────────── Tasks & calendar ─────────────────────────

model Task {
  id             String     @id @default(cuid())
  organizationId String
  title          String
  description    String?
  status         TaskStatus @default(TODO)
  priority       Priority   @default(MEDIUM)
  dueAt          DateTime?
  assigneeId     String?
  authorId       String?
  dealId         String?
  departureId    String?
  stageId        String?
  isSystem       Boolean    @default(false)
  result         String?
  /// [{ t, done }]
  subtasks       Json       @default("[]")
  /// [{ at, text, actor }]
  log            Json       @default("[]")
  createdAt      DateTime   @default(now())
  completedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     Member?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  author       Member?      @relation("TaskAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  departure    Departure?   @relation(fields: [departureId], references: [id], onDelete: Cascade)
  stage        Stage?       @relation(fields: [stageId], references: [id], onDelete: SetNull)

  @@index([organizationId, assigneeId, status])
  @@index([dealId])
}

model Event {
  id             String       @id @default(cuid())
  organizationId String
  type           String // meeting | call | visa | flight | pay | task | briefing
  title          String
  description    String?
  startAt        DateTime
  endAt          DateTime?
  place          String?
  assigneeId     String?
  dealId         String?
  departureId    String?
  remind         String?
  remindedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee       Member?      @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  departure      Departure?   @relation(fields: [departureId], references: [id], onDelete: Cascade)

  @@index([organizationId, startAt])
}

// ───────────────────────── Documents ─────────────────────────

model DocumentTemplate {
  id             String       @id @default(cuid())
  organizationId String
  kind           String // contract | receipt
  name           String
  short          String?
  pipeline       Pipeline?
  condition      String? // receipts: all | pkg | hotel | visa | kids
  fileKey        String?
  /// Plain-text body with {placeholders}, used when no DOCX is uploaded.
  body           String?
  /// [{ placeholder, field, count }]
  variables      Json         @default("[]")
  enabled        Boolean      @default(true)
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contracts      Contract[]
}

model Document {
  id             String   @id @default(cuid())
  organizationId String
  dealId         String
  type           String
  name           String
  fileKey        String
  size           Int?
  createdById    String?
  createdAt      DateTime @default(now())
  deal           Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

model Contract {
  id             String           @id @default(cuid())
  organizationId String
  dealId         String
  templateId     String
  number         String
  kind           String
  fileKey        String?
  values         Json
  emptyFields    String[]
  status         SignStatus       @default(NONE)
  /// Rendered plain text shown on the signing page.
  text           String?
  pdfKey         String?
  /// Receipts sent together share a bundle id (one link for the client).
  bundle         String?
  createdById    String?
  createdAt      DateTime         @default(now())
  annulledAt     DateTime?
  deal           Deal             @relation(fields: [dealId], references: [id], onDelete: Cascade)
  template       DocumentTemplate @relation(fields: [templateId], references: [id])
  signatures     Signature[]

  @@index([dealId])
}

model Signature {
  id         String    @id @default(cuid())
  contractId String
  side       String // client | agency
  token      String    @unique
  memberId   String?
  expiresAt  DateTime?
  signerName String?
  method     String? // ncalayer | egov | sms | paper
  certInfo   Json?
  cms        String?
  signedAt   DateTime?
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Group tours ─────────────────────────

model Departure {
  id             String       @id @default(cuid())
  organizationId String
  tourId         String?      @unique
  name           String
  route          String?
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  type           String
  visa           Boolean
  minSeats       Int
  maxSeats       Int
  price          Int
  guideId        String?
  flightDeadline DateTime     @db.Date
  payDeadline    DateTime     @db.Date
  briefingAt     DateTime     @db.Date
  flightTaskDone Boolean      @default(false)
  hotelTaskDone  Boolean      @default(false)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  guide          Guide?       @relation(fields: [guideId], references: [id], onDelete: SetNull)
  tour           Tour?        @relation(fields: [tourId], references: [id], onDelete: SetNull)
  deals          Deal[]
  participants   Participant[]
  tasks          Task[]
  events         Event[]

  @@index([organizationId, startDate])
}

model Participant {
  id             String     @id @default(cuid())
  organizationId String
  departureId    String
  dealId         String?
  travelerId     String?
  name           String
  passportNote   String?
  paid           Int        @default(0)
  /// Used only when there is no deal; otherwise computed from the deal stage.
  step           Int        @default(0)
  departure      Departure  @relation(fields: [departureId], references: [id], onDelete: Cascade)
  deal           Deal?      @relation(fields: [dealId], references: [id], onDelete: SetNull)
  traveler       Traveler?  @relation(fields: [travelerId], references: [id], onDelete: SetNull)

  @@index([departureId])
}

model Guide {
  id              String       @id @default(cuid())
  organizationId  String
  fullName        String
  iinEnc          String?
  birthDate       DateTime?    @db.Date
  sex             String
  languages       String[]
  experienceYears Int
  agencies        String?
  rate            Int
  rating          Decimal?     @db.Decimal(2, 1)
  reviewsCount    Int          @default(0)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departures      Departure[]
}

model Tour {
  id              String       @id @default(cuid())
  organizationId  String
  slug            String
  name            String
  flags           String?
  countries       String[]
  route           String
  startDate       DateTime?    @db.Date
  endDate         DateTime?    @db.Date
  seats           Int
  price           Int
  prepay          Int
  riseDate        DateTime?    @db.Date
  riseAmount      Int?
  payRule         String?
  description     String
  coverKey        String?
  status          TourStatus   @default(DRAFT)
  included        String[]
  extra           String[]
  rates           Json
  ratesFixedAt    DateTime?
  pricesCheckedAt DateTime?
  posts           Json         @default("[]")
  instagramText   String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departure       Departure?
  days            TourDay[]
  flights         TourFlight[]
  stays           TourStay[]
  costs           TourCost[]

  @@unique([organizationId, slug])
}

model TourDay {
  id                  String   @id @default(cuid())
  tourId              String
  order               Int
  city                String
  items               String[]
  description         String
  transfer            String?
  mediaKeys           String[]
  availabilityChecked Boolean  @default(false)
  tour                Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourFlight {
  id       String    @id @default(cuid())
  tourId   String
  order    Int       @default(0)
  from     String
  to       String
  departAt DateTime?
  airline  String?
  ticket   Decimal?  @db.Decimal(12, 2)
  baggage  Decimal?  @db.Decimal(12, 2)
  currency Currency
  link     String?
  tour     Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourStay {
  id       String    @id @default(cuid())
  tourId   String
  order    Int       @default(0)
  city     String
  name     String
  checkIn  DateTime? @db.Date
  checkOut DateTime? @db.Date
  rooms    Int
  guests   Int
  total    Decimal?  @db.Decimal(12, 2)
  currency Currency
  link     String?
  note     String?
  tour     Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourCost {
  id       String   @id @default(cuid())
  tourId   String
  order    Int      @default(0)
  category String
  plan     Decimal? @db.Decimal(12, 2)
  fact     Decimal? @db.Decimal(12, 2)
  unit     String // KZT | EUR | USD | CHF | PERCENT
  per      String // tourist | group
  tour     Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Package tours ─────────────────────────

model Operator {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  paymentTerms   String
  commissionPct  Decimal           @db.Decimal(4, 1)
  contact        String?
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  offers         Offer[]
  bookings       OperatorBooking[]
}

model Offer {
  id             String          @id @default(cuid())
  organizationId String
  dealId         String
  operatorId     String
  hotel          String
  stars          Int
  resort         String
  fromDate       DateTime        @db.Date
  toDate         DateTime        @db.Date
  meal           String
  room           String
  flight         Boolean
  transfer       Boolean
  insurance      Boolean
  net            Int
  price          Int
  status         OfferStatus     @default(DRAFT)
  selected       Boolean         @default(true)
  note           String?
  source         String?
  externalRef    String?
  createdAt      DateTime        @default(now())
  deal           Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  operator       Operator        @relation(fields: [operatorId], references: [id])
  bookings       OperatorBooking[]
}

model OperatorBooking {
  id              String            @id @default(cuid())
  organizationId  String
  dealId          String
  offerId         String
  operatorId      String
  number          String?
  status          BookingStatus     @default(REQUEST)
  comment         String?
  createdAt       DateTime          @default(now())
  confirmedAt     DateTime?
  paymentDeadline DateTime          @db.Date
  net             Int
  cancelReason    String?
  penalty         Int?
  deal            Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  offer           Offer             @relation(fields: [offerId], references: [id])
  operator        Operator          @relation(fields: [operatorId], references: [id])
  payments        OperatorPayment[]
}

model OperatorPayment {
  id        String          @id @default(cuid())
  bookingId String
  amount    Int
  method    String
  paidAt    DateTime
  booking   OperatorBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Misc ─────────────────────────

model PriceWatch {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  kind           String
  query          Json
  lastPrice      Int
  createdAt      DateTime @default(now())
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  memberId       String
  title          String
  body           String
  link           String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, readAt])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entity         String
  entityId       String
  meta           Json?
  at             DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, at])
}
