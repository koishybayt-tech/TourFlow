{
  "name": "tourflow",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@12.16.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.4",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && prisma generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@iconify-json/lucide": "^1.2.151",
    "@node-rs/argon2": "^2.2.2",
    "@nuxt/ui": "4.12.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "dayjs": "^1.11.23",
    "docxtemplater": "^3.71.1",
    "exceljs": "^4.4.0",
    "motion-v": "^2.11.0",
    "nodemailer": "^10.3.1",
    "nuxt": "4.6.4",
    "nuxt-auth-utils": "^0.6.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pinia": "^4.1.0",
    "pizzip": "^3.3.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.4",
    "vue": "^3.5.44",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@vue/test-utils": "^2.5.1",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "happy-dom": "^21.0.4",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
